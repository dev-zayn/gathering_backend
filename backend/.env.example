# Every variable the api reads. `make env` copies this to backend/.env and
# appends a fresh JWT_PRIVATE_KEY. Defaults are in internal/conf/conf.go.

ADDR=:8080
VERSION=dev
LOG_LEVEL=info
LOG_FORMAT=text

# A laptop. Codes go to the log, DEV_ADMIN opens the console without a
# provider, FILES_DIR stands in for the bucket. Never on in production.
DEBUG=true
DEV_ADMIN=true
FILES_DIR=.files

# ── Stores ──
DATABASE_URL=postgres://gathering:gathering@localhost:5433/gathering?sslmode=disable
REDIS_URL=redis://localhost:6380/0
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
LOGS_DB_MAX_OPEN_CONNS=5
LOGS_DB_MAX_IDLE_CONNS=2

# ── Addresses ──
API_PUBLIC_URL=http://localhost:8080
JWT_ISSUER=http://localhost:8080
DOCS_URL=http://localhost:8092
CORS_ORIGINS=http://localhost:8085,http://localhost:8092

# ── Invite links (docs/JOINING.md): the page at LINK_PUBLIC_URL/r/{code} and
# the phones' two documents; no fingerprint or no team id serves the empty form ──
LINK_PUBLIC_URL=http://localhost:8080
APP_ANDROID_PACKAGE=app.gathering.jamaa
# Comma list of the signing certificates' SHA-256 fingerprints, AA:BB:…
APP_LINKS_SHA256=
APPLE_TEAM_ID=
APP_IOS_BUNDLE=app.gathering.jamaa
APP_STORE_URL=
PLAY_STORE_URL=

# ── Pictures (avatars, icons, screenshots): real S3, or FILES_DIR on a laptop ──
S3_BUCKET=
S3_REGION=me-south-1
S3_AVATAR_URL_TTL=1h
S3_ICON_URL_TTL=1h
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Admin sign-in: any OIDC provider that puts roles in a claim ──
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_AUDIENCE=
SSO_ROLES_CLAIM=roles
SSO_SERVICE=gathering
SSO_DIAL=

# ── Tokens ──
# JWT_PRIVATE_KEY is appended by `make env`.
TOKEN_OTP_TTL=5m
TOKEN_SIGNUP_TTL=15m
TOKEN_SESSION_TTL=1h
TOKEN_REFRESH_TTL=2160h
TOKEN_ADMIN_TTL=12h
TOKEN_ADMIN_IDLE=10m
TOKEN_CODE_TTL=1m
TOKEN_GAME_TTL=1h
TOKEN_ROOM_TTL=10m
INSECURE_COOKIE=false

# ── One-time codes: a webhook to your SMS/WhatsApp gateway; the log with DEBUG ──
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=
# Every code is this one, for the e2e sweep. DEBUG only.
OTP_FIXED_CODE=
OTP_TIMEOUT=30s
OTP_CODE_TTL=5m
OTP_ATTEMPTS=5
OTP_CEILING=120
OTP_COOLDOWN=1m
OTP_HOURLY=5
OTP_RESENDS=2

# ── Push (Firebase Cloud Messaging, docs/PUSH.md). Without a key file every
# push is a "would push" line in the api's log and nothing is sent. The key is
# a service account's JSON key from the Firebase console (Project settings →
# Service accounts); keep it outside the repository and name its path here. ──
FCM_PROJECT_ID=gathering-supergame
FCM_CREDENTIALS_FILE=
# Firebase's base URL, https://fcm.googleapis.com when empty; a test's fake otherwise.
FCM_ENDPOINT=
FCM_TIMEOUT=10s

# ── Rooms and the relay ──
RELAY_MAX_FRAME=16384
RELAY_RATE=30
RELAY_MAX_MEMBERS=64
PRESENCE_TTL=60s
ROOM_LOBBY_IDLE=10m
ROOM_MAX_PLAY=2h
ROOM_CODE_ALPHABET=ABCDEFGHJKLMNPQRSTUVWXYZ23456789

# ── Tournaments (docs/TOURNAMENTS.md): the largest knockout (64 at most), and
# how long one with no start time may sit open before the clock calls it off.
# A tournament's code is drawn from ROOM_CODE_ALPHABET.
TOURNAMENT_MAX_ENTRANTS=64
TOURNAMENT_OPEN_FOR=168h

# ── Housekeeping ──
SWEEP_INTERVAL=1m
CODE_RETENTION=24h
MANIFEST_MAX_AGE=24h
MANIFEST_BATCH=20
ALLOW_PRIVATE_HOSTS=true
